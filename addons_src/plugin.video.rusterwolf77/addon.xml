<?xml version="1.0" encoding="utf-8"?>
<addon id="plugin.video.rusterwolf77" version="2.0.12" name="RusterWolf 77" provider-name="Rusterboy77">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.addon.signals" version="0.0.6"/>
        <import addon="service.upnext" version="1.1.0"/>
        <import addon="script.module.pycryptodome" />
        <import addon="script.module.requests" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="login" />
    <extension point="xbmc.addon.metadata">
        <summary lang="es">Catálogo de torrents con soporte Debrid y P2P</summary>
        <description lang="es">Addon de video que ofrece reproducción instantánea mediante cuentas premium (Real-Debrid, AllDebrid) y mantiene la opción de reproducción P2P gratuita mediante Elementum.</description>
        <platform>all</platform>
        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpeg</fanart>
        </assets>
    </extension>
</addon>

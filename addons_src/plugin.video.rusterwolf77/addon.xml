<?xml version="1.0" encoding="utf-8"?>
<addon id="plugin.video.rusterwolf77" version="0.1.2" name="RusterWolf 77" provider-name="rusterboy77">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="es">Catálogo de torrents con reproducción en Elementum</summary>
        <description lang="es">Addon de video que lista torrents desde JSON en GitHub, organiza por películas, series, documentales y permite búsqueda. Reproduce mediante Elementum si está instalado.</description>
        <platform>all</platform>
        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpeg</fanart>
        </assets>
    </extension>
</addon>

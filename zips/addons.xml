<?xml version="1.0" encoding="utf-8"?>
<addons>
    <addon id="plugin.video.atresplayer77" name="Atresplayer 77" version="0.1.1" provider-name="Rusterboy77">
        
    
        <requires>
            
        
            <import addon="xbmc.python" version="3.0.0"/>
            
        
            <import addon="script.module.requests"/>
            
        
            <import addon="inputstream.adaptive"/>
            
    
        </requires>
        
    
        <extension point="xbmc.python.pluginsource" library="main.py">
            
        
            <provides>video</provides>
            
    
        </extension>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="en">Atresplayer Client</summary>
            
        
            <description lang="en">Addon para ver contenido de Atresplayer usando cuenta oficial.</description>
            
        
            <platform>all</platform>
            
        
            <license>MIT</license>
            
        
            <assets>
                
            
                <icon>icon.png</icon>
                
            
                <fanart>fanart.jpg</fanart>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
    <addon id="plugin.video.rusterwolf77" version="0.1.2" name="RusterWolf 77" provider-name="rusterboy77">
        
    
        <requires>
            
        
            <import addon="xbmc.python" version="3.0.0"/>
            
    
        </requires>
        
    
        <extension point="xbmc.python.pluginsource" library="default.py">
            
        
            <provides>video</provides>
            
    
        </extension>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="es">Catálogo de torrents con reproducción en Elementum</summary>
            
        
            <description lang="es">Addon de video que lista torrents desde JSON en GitHub, organiza por películas, series, documentales y permite búsqueda. Reproduce mediante Elementum si está instalado.</description>
            
        
            <platform>all</platform>
            
        
            <assets>
                
            
                <icon>resources/media/icon.png</icon>
                
            
                <fanart>resources/media/fanart.jpeg</fanart>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
    <addon id="repository.rusterboy77" name="Rusterboy77 Repository" version="1.0.1" provider-name="Rusterboy77">
        
    
        <extension point="xbmc.addon.repository" name="Rusterboy Repository">
            
        
            <dir>
                
            
                <info compressed="false">https://rusterboy77.github.io/Rusterboy77-tg-catalog/zips/addons.xml</info>
                
            
                <checksum>https://rusterboy77.github.io/Rusterboy77-tg-catalog/zips/addons.xml.md5</checksum>
                
            
                <datadir zip="true">https://rusterboy77.github.io/Rusterboy77-tg-catalog/zips/</datadir>
                
        
            </dir>
            
    
        </extension>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary>Repositorio de Rusterboy</summary>
            
        
            <description>Instala y actualiza mis addons automáticamente</description>
            
        
            <platform>all</platform>
            
        
            <assets>
                
            
                <icon>icon.png</icon>
                
            
                <fanart>fanart.jpg</fanart>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
</addons>

<?xml version="1.0" encoding="utf-8"?>
<addons>
    <addon id="plugin.video.atresplayer77" name="Atresplayer 77" version="1.0.4" provider-name="Rusterboy77">
        
    
        <requires>
            
        
            <import addon="xbmc.python" version="3.0.0"/>
            
        
            <import addon="script.module.requests"/>
            
        
            <import addon="inputstream.adaptive"/>
            
    
        </requires>
        
    
        <extension point="xbmc.python.pluginsource" library="main.py">
            
        
            <provides>video</provides>
            
    
        </extension>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="en">Atresplayer Client</summary>
            
        
            <description lang="en">Addon para ver contenido de Atresplayer usando cuenta oficial.</description>
            
        
            <platform>all</platform>
            
        
            <license>MIT</license>
            
        
            <assets>
                
            
                <icon>icon.png</icon>
                
            
                <fanart>fanart.jpg</fanart>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
    <addon id="plugin.video.choloretro" version="1.0.23" name="CholoRetro" provider-name="Rusterboy77">
        
    
        <requires>
            
        
            <import addon="xbmc.python" version="3.0.0"/>
            
        
            <import addon="script.module.requests"/>
            
        
            <import addon="service.upnext" version="1.1.0"/>
            
        
            <import addon="script.module.addon.signals" version="0.0.6"/>
            
    
        </requires>
        
    
        <extension point="xbmc.python.pluginsource" library="main.py">
            
        
            <provides>video</provides>
            
    
        </extension>
        
    
        <extension point="xbmc.service" library="service.py" start="login"/>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="es">Contenido Retro</summary>
            
        
            <description lang="es">Addon de contenido retro alojado en 1fichier, potenciado por AllDebrid.</description>
            
        
            <platform>all</platform>
            
        
            <assets>
                
            
                <icon>icon.png</icon>
                
            
                <fanart>fanart.jpg</fanart>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
    <addon id="plugin.video.rusterwolf77" version="1.0.20" name="RusterWolf 77" provider-name="Rusterboy77">
        
    
        <requires>
            
        
            <import addon="xbmc.python" version="3.0.0"/>
            
        
            <import addon="script.module.addon.signals" version="0.0.6"/>
            
        
            <import addon="service.upnext" version="1.1.0"/>
            
    
        </requires>
        
    
        <extension point="xbmc.python.pluginsource" library="default.py">
            
        
            <provides>video</provides>
            
    
        </extension>
        
    
        <extension point="xbmc.service" library="service.py" start="login"/>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="es">Catálogo de torrents con soporte premium Debrid y P2P</summary>
            
        
            <description lang="es">Addon de video que lista torrents y organiza por películas, series y documentales. Ofrece reproducción instantánea mediante cuentas premium (Real-Debrid, AllDebrid) comprobando su caché, y mantiene la opción de reproducción P2P gratuita mediante Elementum.</description>
            
        
            <platform>all</platform>
            
        
            <assets>
                
            
                <icon>resources/media/icon.png</icon>
                
            
                <fanart>resources/media/fanart.jpeg</fanart>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
    <addon id="repository.rusterboy77" name="Rusterboy77 Repository" version="1.0.1" provider-name="Rusterboy77">
        
    
        <extension point="xbmc.addon.repository" name="Rusterboy Repository">
            
        
            <dir>
                
            
                <info compressed="false">https://rusterboy77.github.io/Rusterboy77-tg-catalog/zips/addons.xml</info>
                
            
                <checksum>https://rusterboy77.github.io/Rusterboy77-tg-catalog/zips/addons.xml.md5</checksum>
                
            
                <datadir zip="true">https://rusterboy77.github.io/Rusterboy77-tg-catalog/zips/</datadir>
                
        
            </dir>
            
    
        </extension>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary>Repositorio de Rusterboy</summary>
            
        
            <description>Instala y actualiza mis addons automáticamente</description>
            
        
            <platform>all</platform>
            
        
            <assets>
                
            
                <icon>icon.png</icon>
                
            
                <fanart>fanart.jpg</fanart>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
    <addon id="script.palantir.bridge" name="Palantir Bridge" version="1.0.3" provider-name="Rusterboy77">
        
  
        <requires>
            
    
            <import addon="xbmc.python" version="3.0.0"/>
            
    
            <import addon="plugin.video.palantir3" optional="true"/>
            
    
            <import addon="script.module.requests"/>
            
  
        </requires>
        
  
        <extension point="xbmc.python.script" library="default.py"/>
        
  
        <extension point="xbmc.python.pluginsource" library="default.py">
            
    
            <provides>executable</provides>
            
  
        </extension>
        
  
        <extension point="xbmc.addon.metadata">
            
    
            <summary lang="en_GB">Busqueda externa para Palantir 3</summary>
            
    
            <description lang="en_GB">Permite a las skins buscar en Palantir 3</description>
            
    
            <platform>all</platform>
            
  
        </extension>
        

    </addon>
</addons>
